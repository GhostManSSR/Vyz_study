digraph Automaton {
    rankdir=LR;
    graph [label="Исходный НКА", labelloc=t];
    node [shape=circle];
    "__start" [shape=point, label=""];
    "__start" -> "p";
    "p" [label="p"];
    "q" [label="q"];
    "r" [label="r", shape=doublecircle];
    "p" -> "p" [label="0"];
    "p" -> "p" [label="1"];
    "p" -> "q" [label="1"];
    "q" -> "r" [label="1"];
}
