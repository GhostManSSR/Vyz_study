digraph Automaton {
    rankdir=LR;
    graph [label="Исходный НКА", labelloc=t];
    node [shape=circle];
    "q1" [label="q1"];
    "q2" [label="q2", shape=doublecircle];
    "q3" [label="q3"];
    "q1" -> "q1" [label="0"];
    "q1" -> "q2" [label="0"];
    "q1" -> "q1" [label="1"];
    "q2" -> "q3" [label="1"];
    "q3" -> "q3" [label="0"];
    "q3" -> "q1" [label="1"];
    "q3" -> "q3" [label="1"];
}
