digraph Automaton {
    rankdir=LR;
    graph [label="ДКА перед минимизацией", labelloc=t];
    node [shape=circle];
    "A" [label="A"];
    "B" [label="B", shape=doublecircle];
    "C" [label="C"];
    "D" [label="D", shape=doublecircle];
    "A" -> "B" [label="0"];
    "A" -> "A" [label="1"];
    "B" -> "B" [label="0"];
    "B" -> "C" [label="1"];
    "C" -> "D" [label="0"];
    "C" -> "C" [label="1"];
    "D" -> "D" [label="0"];
    "D" -> "C" [label="1"];
}
