digraph Automaton {
    rankdir=LR;
    graph [label="ДКА перед минимизацией", labelloc=t];
    node [shape=circle];
    "__start" [shape=point, label=""];
    "__start" -> "A";
    "A" [label="A"];
    "B" [label="B"];
    "C" [label="C", shape=doublecircle];
    "A" -> "A" [label="0"];
    "A" -> "B" [label="1"];
    "B" -> "A" [label="0"];
    "B" -> "C" [label="1"];
    "C" -> "A" [label="0"];
    "C" -> "C" [label="1"];
}
